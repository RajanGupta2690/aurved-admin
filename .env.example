# AURVED Admin - Environment Variables

# API Configuration
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_TIMEOUT=30000

# Authentication
VITE_AUTH_TOKEN_KEY=aurved_auth_token
VITE_REFRESH_TOKEN_KEY=aurved_refresh_token

# Institution
VITE_DEFAULT_INSTITUTION_ID=inst-1

# Feature Flags
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_NOTIFICATIONS=true
VITE_ENABLE_PAYMENT_GATEWAY=false

# Payment Gateway (Future)
VITE_RAZORPAY_KEY_ID=
VITE_STRIPE_PUBLIC_KEY=

# File Upload
VITE_MAX_FILE_SIZE=5242880
VITE_ALLOWED_FILE_TYPES=pdf,doc,docx,jpg,jpeg,png

# AWS Configuration (Future)
VITE_AWS_REGION=ap-southeast-2
VITE_AWS_S3_BUCKET=

# Environment
VITE_APP_ENV=development
VITE_APP_VERSION=1.0.0
