// User roles in the system
export enum UserRole {
  SUPER_ADMIN = 'super_admin',
  ADMIN_STAFF = 'admin_staff',
  TEACHER = 'teacher',
  LIBRARIAN = 'librarian',
  ACCOUNTANT = 'accountant',
  TRANSPORT_MANAGER = 'transport_manager',
  RECEPTIONIST = 'receptionist',
}

// All possible permissions in the system
export enum Permission {
  // Dashboard
  VIEW_DASHBOARD = 'view_dashboard',
  
  // Students
  VIEW_STUDENTS = 'view_students',
  ADD_STUDENT = 'add_student',
  EDIT_STUDENT = 'edit_student',
  DELETE_STUDENT = 'delete_student',
  
  // Admissions
  VIEW_ADMISSIONS = 'view_admissions',
  PROCESS_ADMISSION = 'process_admission',
  
  // Parents
  VIEW_PARENTS = 'view_parents',
  EDIT_PARENTS = 'edit_parents',
  
  // Staff
  VIEW_STAFF = 'view_staff',
  ADD_STAFF = 'add_staff',
  EDIT_STAFF = 'edit_staff',
  DELETE_STAFF = 'delete_staff',
  MANAGE_ROLES = 'manage_roles',
  
  // Attendance
  VIEW_ATTENDANCE = 'view_attendance',
  MARK_ATTENDANCE = 'mark_attendance',
  
  // Fees
  VIEW_FEES = 'view_fees',
  COLLECT_FEES = 'collect_fees',
  MANAGE_FEE_STRUCTURE = 'manage_fee_structure',
  
  // Examinations
  VIEW_EXAMINATIONS = 'view_examinations',
  CREATE_EXAM = 'create_exam',
  ENTER_MARKS = 'enter_marks',
  
  // Homework
  VIEW_HOMEWORK = 'view_homework',
  ASSIGN_HOMEWORK = 'assign_homework',
  
  // Communication
  VIEW_NOTICES = 'view_notices',
  CREATE_NOTICE = 'create_notice',
  
  // Academics
  VIEW_ACADEMICS = 'view_academics',
  MANAGE_CURRICULUM = 'manage_curriculum',
  
  // Timetable
  VIEW_TIMETABLE = 'view_timetable',
  EDIT_TIMETABLE = 'edit_timetable',
  
  // Library
  VIEW_LIBRARY = 'view_library',
  MANAGE_BOOKS = 'manage_books',
  ISSUE_RETURN_BOOKS = 'issue_return_books',
  
  // Transport
  VIEW_TRANSPORT = 'view_transport',
  MANAGE_VEHICLES = 'manage_vehicles',
  MANAGE_ROUTES = 'manage_routes',
  
  // Inventory
  VIEW_INVENTORY = 'view_inventory',
  MANAGE_INVENTORY = 'manage_inventory',
  
  // Reports
  VIEW_REPORTS = 'view_reports',
  GENERATE_REPORTS = 'generate_reports',
  
  // Settings
  VIEW_SETTINGS = 'view_settings',
  EDIT_SETTINGS = 'edit_settings',
}

// Permission sets for each role
export const ROLE_PERMISSIONS: Record<UserRole, Permission[]> = {
  [UserRole.SUPER_ADMIN]: Object.values(Permission), // All permissions
  
  [UserRole.ADMIN_STAFF]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_ADMISSIONS,
    Permission.PROCESS_ADMISSION,
    Permission.VIEW_PARENTS,
    Permission.VIEW_STAFF,
    Permission.VIEW_FEES,
    Permission.COLLECT_FEES,
    Permission.VIEW_INVENTORY,
    Permission.MANAGE_INVENTORY,
    Permission.VIEW_REPORTS,
    Permission.GENERATE_REPORTS,
    Permission.VIEW_NOTICES,
  ],
  
  [UserRole.TEACHER]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_ATTENDANCE,
    Permission.MARK_ATTENDANCE,
    Permission.VIEW_EXAMINATIONS,
    Permission.ENTER_MARKS,
    Permission.VIEW_HOMEWORK,
    Permission.ASSIGN_HOMEWORK,
    Permission.VIEW_NOTICES,
    Permission.VIEW_TIMETABLE,
    Permission.VIEW_ACADEMICS,
  ],
  
  [UserRole.LIBRARIAN]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_LIBRARY,
    Permission.MANAGE_BOOKS,
    Permission.ISSUE_RETURN_BOOKS,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_NOTICES,
  ],
  
  [UserRole.ACCOUNTANT]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_FEES,
    Permission.COLLECT_FEES,
    Permission.MANAGE_FEE_STRUCTURE,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_REPORTS,
    Permission.GENERATE_REPORTS,
    Permission.VIEW_NOTICES,
  ],
  
  [UserRole.TRANSPORT_MANAGER]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_TRANSPORT,
    Permission.MANAGE_VEHICLES,
    Permission.MANAGE_ROUTES,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_NOTICES,
  ],
  
  [UserRole.RECEPTIONIST]: [
    Permission.VIEW_DASHBOARD,
    Permission.VIEW_STUDENTS,
    Permission.VIEW_ADMISSIONS,
    Permission.PROCESS_ADMISSION,
    Permission.VIEW_PARENTS,
    Permission.VIEW_NOTICES,
    Permission.VIEW_FEES,
  ],
};

// User interface
export interface User {
  id: string;
  name: string;
  email: string;
  role: UserRole;
  permissions: Permission[];
  avatar?: string;
  
  // Additional teacher-specific fields
  assignedClasses?: string[]; // Class IDs
  assignedSubjects?: string[]; // Subject IDs
  
  // Additional info
  phone?: string;
  employeeId?: string;
  joinDate?: string;
  isActive: boolean;
}

// Auth context state
export interface AuthState {
  user: User | null;
  isAuthenticated: boolean;
  isLoading: boolean;
}
